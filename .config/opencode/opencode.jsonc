{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git commit *": "ask",
      "git push *": "ask",
      "sudo *": "ask"
    }
  },
  "provider": {
    "synthetic": {
      "models": {
        "hf:zai-org/GLM-5.2": {
          "variants": {
          	"none": {
          		"reasoningEffort": "none"
          	},
          	"high": {
          		"reasoningEffort": "high"
          	},
          	"max": {
          		"reasoningEffort": "max"
          	},
          	
          } 
        }
      }
    }
  }
}
